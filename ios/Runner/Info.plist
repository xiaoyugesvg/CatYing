<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneDelegateClassName</key>
						<string>FlutterSceneDelegate</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>FlutterDeepLinkingEnabled</key>
		<false/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
	<string>猫影</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>猫影</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- iOS 13+ 推荐配置：用 UILaunchScreen 字典替代 LaunchScreen.storyboard。
		     ✅ 2026-10-07 修复「每次打开黑闪一下」：
		       原来这里是**空字典** `<dict/>` ⇒ 按 Apple 规则，未指定 UIColorName 时
		       系统用 `UIColor.systemBackground` 兜底，而它是**随明暗自适应的动态色**
		       （浅色=白 / 深色=黑）。App 默认外观又是「跟随系统」⇒ 深色设备上
		       启动屏整块是**纯黑**，直到 Flutter 画出第一帧才消失 = 用户看到的黑闪。
		       现在显式指向资源目录里的 `LaunchBackground` 颜色集
		       （any=#F7F5F1 宣纸米白 / dark=#1C1C1E 墨夜，即 App 首屏底色），
		       启动那一下与首屏同色，黑闪消失。
		     ⚠️ 不要改回 `<dict/>`（那会退回系统黑/白兜底）。
		     不引用任何 storyboard / 图片，编译产物依旧最小。 -->
		<key>UILaunchScreen</key>
		<dict>
			<key>UIColorName</key>
			<string>LaunchBackground</string>
		</dict>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<true/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>请允许APP保存图片到相册</string>
		<key>NSCameraUsageDescription</key>
		<string>App需要您的同意,才能访问相机</string>
		<key>NSAppleMusicUsageDescription</key>
		<string>App需要您的同意,才能访问媒体资料库</string>
		<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
	</array>
	<!-- 应用 URL Scheme 注册 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.newtvbox.app</string>
			<key>CFBundleURLSchemes</key>
	<array>
		<string>newtv</string>
		<string>catbox</string>
	</array>
		</dict>
	</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<!-- flutter_foreground_task 需要（它自己 example/Info.plist 里就是这两个键）。
			     当前 Dart 侧只在 Android 上调用该插件（peer_transfer_service.dart 有
			     Platform.isAndroid 判断），iOS 上实际用不到；但插件注册时会读
			     BGTaskSchedulerPermittedIdentifiers，缺了它插件会直接 return。
			     留着以免以后要用 iOS 后台任务时静默失效。 -->
			<string>fetch</string>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.pravera.flutter_foreground_task.refresh</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSLocalNetworkUsageDescription</key>
		<string>需要访问本地网络以发现和连接 DLNA 投屏设备</string>
		<key>NSBonjourServices</key>
		<array>
			<string>_ssdp._udp</string>
			<string>_upnp._tcp</string>
			<string>_http._tcp</string>
			<!-- 阅读模块「局域网传书」用 bonsoir 广播/发现设备。
			     iOS 14+ 必须把服务名声明在这里，否则**发现不到任何设备**
			     （不报错，只是静默失败）。名字来自
			     reading/services/peer_transfer_service.dart 的 _kServiceType。 -->
			<string>_cmbok._tcp</string>
		</array>
		<!-- 放行任意 http 明文流（TrollStore 侧载，不面向 App Store 审核）
		     原因：大量影视/直播 m3u8 源是 http://，原生 AVPlayer(画中画) 受 ATS
		     限制会直接加载失败 → PiP 时灵时不灵；media_kit/libmpv 用自己的
		     网络栈不受 ATS 影响，所以表现为"主播放器能播、PiP 失败" -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>
		<!-- 阅读模块：把 App 沙盒的 Documents 暴露给「文件」App。
		     不开这两个键，「文件 → 我的 iPhone」里看不到本 App，
		     用户**没有任何途径**把 TXT/EPUB 放进沙盒 → 阅读功能等于不可用。
		     （阅读器用的是自实现的文件浏览器，读的就是这个目录） -->
		<key>UIFileSharingEnabled</key>
		<true/>
		<key>LSSupportsOpeningDocumentsInPlace</key>
		<true/>
	</dict>
</plist>
