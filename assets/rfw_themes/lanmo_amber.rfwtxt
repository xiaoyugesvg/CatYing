      ),
      "card" : PeekCarousel(
        autoPlay: true,
        style: "stack",
        showIndicators: false,
        interval: 4300,
        viewportFraction: 0.8,
        stackScale: 0.9,
        stackOpacity: 0.21,
        stackOffset: 0.21,
        stackRotation: 0.022,
        activeColor: 0xFFD4A373,
        inactiveColor: 0x44D4A373,
        children: [
          ...for item in data.home.home.recommend:
