// 空/加载状态
// ============================================
// 加载骨架（2026-10-30）
// 用户：「RWF 主题的内容加载页面不好看」——原来加载时只有正中间一行
// 「正在加载中...」，整块内容区空着，看着像坏了。现在铺骨架卡：
// 与真实海报卡同宽同高的圆角灰块 + 底部一行「正在加载…」。
// ⚠️ 颜色只能走 `decoration: {type:"box", ...}`，不能写
//    `Container(color: …, borderRadius: …)`：RFW 的 Container 解码成
//    AnimatedContainer，color 与 decoration 同时非空会直接断言崩。
// ============================================
widget SkeletonPoster = Column(
  crossAxisAlignment: "start",
  children: [
    Container(
      height: 150.0,
      decoration: {
        type: "box",
        color: 0xFF262C35,
        borderRadius: [ { x: 10.0 } ],
      },
    ),
    Padding(
      padding: [ 0.0, 8.0, 0.0, 0.0 ],
      child: Container(
        height: 10.0,
        decoration: {
          type: "box",
          color: 0xFF1F242B,
          borderRadius: [ { x: 5.0 } ],
        },
      ),
    ),
    Padding(
      padding: [ 0.0, 6.0, 0.0, 0.0 ],
      child: Container(
        width: 52.0,
        height: 10.0,
        decoration: {
          type: "box",
          color: 0xFF1F242B,
          borderRadius: [ { x: 5.0 } ],
        },
      ),
    ),
  ],
);

widget LoadingSkeleton = Container(
  padding: [ 12.0, 14.0, 12.0, 0.0 ],
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Row(
        children: [
          Container(
            width: 96.0,
            height: 13.0,
            decoration: {
              type: "box",
              color: 0xFF262C35,
              borderRadius: [ { x: 7.0 } ],
            },
          ),
          Spacer(),
          Container(
            width: 42.0,
            height: 13.0,
            decoration: {
              type: "box",
              color: 0xFF262C35,
              borderRadius: [ { x: 7.0 } ],
            },
          ),
        ],
      ),
      Padding(
        padding: [ 0.0, 14.0, 0.0, 0.0 ],
        child: Row(
          crossAxisAlignment: "start",
          children: [
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
          ],
        ),
      ),
      Padding(
        padding: [ 0.0, 12.0, 0.0, 0.0 ],
        child: Row(
          crossAxisAlignment: "start",
          children: [
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
          ],
        ),
      ),
      Padding(
        padding: [ 0.0, 18.0, 0.0, 0.0 ],
        child: Row(
          children: [
            Container(
              width: 13.0,
              height: 13.0,
              decoration: {
                type: "box",
                color: 0xFFD4A373,
                borderRadius: [ { x: 7.0 } ],
              },
            ),
            SizedBox(width: 8.0),
            Text(
              text: "正在加载…",
              style: { color: 0xFF8C99AB, fontSize: 12.0 },
            ),
          ],
        ),
      ),
    ],
  ),
);

widget EmptyState = switch data.home.loading {
  true: LoadingSkeleton(),

  false: switch data.home.errorMessage {
    "": Center(
      child: Column(
        mainAxisSize: "min",
        children: [
          Text(
            text: "◈",
            style: { fontSize: 36.0, color: 0xFF6D7D94 },
          ),
          Padding(
            padding: [ 0.0, 8.0, 0.0, 0.0 ],
            child: Text(
              text: "暂无条目",
              style: { color: 0xFF6D7D94, fontSize: 13.0 },
            ),
          ),
        ],
      ),
    ),
    default: GestureDetector(
      onTap: event "refresh" {},
      child: Center(
        child: Column(
          mainAxisSize: "min",
          children: [
            Text(
              text: "",
              style: { fontSize: 36.0, color: 0xFFD4A373 },
            ),
            Padding(
              padding: [ 0.0, 8.0, 0.0, 0.0 ],
              child: Text(
                text: data.home.errorMessage,
                maxLines: 2,
                overflow: "ellipsis",
                style: { color: 0xFFD4A373, fontSize: 12.0 },
