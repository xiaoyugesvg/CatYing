// 分类标签 - 采用沉浸光影的玻璃质感样式，保留琥珀配色
widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    margin: [ 0.0, 4.0, 8.0, 4.0 ],
    padding: [ 14.0, 0.0 ],
    height: 30.0,
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected {
        true: 0xFFD4A373,
        false: 0x1EFFFFFF,
      },
      borderRadius: [ { x: 18.0 } ],
      border: [
        {
          color: switch args.item.selected {
            true: 0xFFD4A373,
            false: 0xFFD4A373,
          },
          width: 1.2,
        },
      ],
      boxShadow: switch args.item.selected {
        true: [ { color: 0x44D4A373, blurRadius: 12.0 } ],
        false: [],
      },
    },
    child: Text(
      text: args.item.typeName,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected {
          true: 0xFF0B0D10,
          false: 0xF5FFFFFF,
        },
        fontSize: 12.0,
        fontWeight: "w800",
        height: 1.0,
      },
    ),
  ),
);

// 工具按钮 - 采用沉浸光影的玻璃质感样式，保留琥珀配色
