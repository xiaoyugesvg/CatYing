// ============================================
// 按钮栏 - 独立一行，所有操作按钮
// ============================================
widget ActionBar = Container(
  color: 0xFF1A1E24,
  padding: [ 12.0, 2.0, 12.0, 2.0 ],
  child: Row(
    mainAxisAlignment: "spaceBetween",
    children: [
      // 筛选
      switch data.home.hasFilters {
        true: TinyToolButton(
          icon: data.home.icons.filter,
          active: data.home.showFilters,
          action: event "toggleFilters" {},
        ),
        false: SizedBoxShrink(),
      },
      // API
      TinyToolButton(
        icon: data.home.icons.api,
        active: false,
        action: event "showApiConfigPicker" {},
      ),
      // 搜索
      TinyToolButton(
        icon: data.home.icons.search,
        active: false,
        action: event "openSearch" {},
      ),
      // 推送
      TinyToolButton(
        icon: data.home.icons.push,
        active: false,
        action: event "openPush" {},
      ),
      // 历史
      TinyToolButton(
        icon: data.home.icons.history,
        active: false,
        action: event "openHistory" {},
      ),
      // 收藏
      TinyToolButton(
        icon: data.home.icons.favorite,
        active: false,
        action: event "openFavorite" {},
      ),
      // 布局
      TinyToolButton(
        icon: data.home.icons.layout,
        active: false,
        action: event "showDisplayStylePicker" {},
      ),
      // 刷新
      TinyToolButton(
        icon: data.home.icons.refresh,
        active: false,
        action: event "refresh" {},
      ),
      // 分类展开（如果有多个分类）
      switch data.home.hasManyClasses {
        true: TinyToolButton(
          icon: data.home.icons.expand,
          active: false,
          action: event "showCategoryPicker" {},
        ),
        false: SizedBoxShrink(),
      },
      // 站源切换
      TinyToolButton(
        icon: data.home.icons.source,
        active: false,
        action: event "showSourcePicker" {},
      ),
    ],
  ),
);

