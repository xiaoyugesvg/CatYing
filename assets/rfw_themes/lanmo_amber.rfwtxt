// 筛选行
widget FilterRow = Row(
  children: [
    Expanded(
      child: SingleChildScrollView(
        scrollDirection: "horizontal",
        child: Row(
          mainAxisSize: "min",
          children: [
          ...for option in args.group.options:
            Padding(
              padding: [ 0.0, 1.0, 8.0, 1.0 ],
              child: FilterOption(item: option),
            ),
        ],
        ),
      ),
    ),
    switch args.group.canExpand {
      true: Padding(
        padding: [ 6.0, 1.0, 0.0, 1.0 ],
        child: ToolButton(
          icon: data.home.icons.expand,
          active: false,
          action: event "showFilterPicker" { key: args.group.key },
        ),
      ),
      false: SizedBoxShrink(),
    },
  ],
);

