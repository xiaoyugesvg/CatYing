// ============================================
// 根组件 - 布局结构：
// ============================================
widget root = Container(
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: 0.0, y: -1.0 },
      end: { x: 0.0, y: 1.0 },
      colors: [ 0xFF0B0D10, 0xFF1A1E24, 0xFF0B0D10 ],
    },
  },
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend {
      true: switch data.home.displayStyle {
        "grid" : 500.0,
        "largeGrid" : 620.0,
        "banner" : 250.0,
        "list" : 300.0,
        "list2" : 240.0,
        "textList" : 150.0,
        "card" : 220.0,
        "default" : 500.0,
      },
      false: 0.0,
    },
    // 吸顶头高度必须等于 PinnedHeader 的实际内容高度，写死就会溢出：
    //   · 收起筛选：分类栏 58（padding 6+6 + 内框 46）+ 按钮栏 34
    //     （padding 2+2 + 圆钮 30）= 92，原来写 90 ⇒ RenderFlex 差 2px。
    //   · 展开筛选：还要加 FilterPanel 的上下 padding 10 和面板本身的高度，
    //     也就是 102 + immersiveFilterPanelHeight。
    // RFW 的词法里没有 `+`，所以两个数都由 data 侧算好。
    pinnedHeight: data.home.immersiveStickyHeaderHeight,
    sectionHeight: 56.0,
    crossAxisCount: switch data.home.displayStyle {
      "grid": data.home.gridColumns,
      "largeGrid": data.home.largeGridColumns,
      "banner": data.home.bannerColumns,
      "list": 1,
      "list2": 2,
      "textList": 1,
      "card": 1,
      default: data.home.gridColumns,
    },
    childAspectRatio: switch data.home.displayStyle {
      "grid": 0.4,
      "largeGrid": 0.48,
      "banner": 1.55,
      "list": data.home.wideListRatio,
      "list2": 1.38,
      "textList": data.home.textListRatio,
      "card": 1.55,
      default: 0.48,
    },
    mainAxisSpacing: 8.0,
    crossAxisSpacing: 8.0,
    horizontalPadding: 10.0,
    bottomPadding: 88.0,
    hero: HeroSection(),
    pinnedHeader: PinnedHeader(),
    sectionHeader: SectionBar(),
    empty: EmptyState(),
    children: [
      ...for item in data.home.items:
        ThemeItem(item: item),
    ],
  ),
);