// 晨光网格 —— 暖色调偏移 · 三列海报墙 · 细描边
//
// ⚠️ 颜色一律从 `data.home.theme.*` 取，不许写死色值。
// 色值由 lib/rfw_theme/rfw_theme_palette.dart 按「软件当前配色 + 暖色调偏移」算好。
//
// ── 视觉语言（2026-10-30 重做）─────────────────────────────────
// 用户：「幻灯片、卡片等等应该要和 RWF 的主题样式，你没有仔细读取主题运用呢」
//
// 之前三个主题的 PosterItem / RowItem / BannerItem 是**同一份复制粘贴**，
// 只有 hero 有无的区别 —— 那算不上"主题"，只是换了个颜色。
// 现在每个主题有自己的卡片语言：
//   · 晨光网格 = 网格感。海报带 1px 细描边（像相册里贴的照片），
//     分组标题前有一根强调色竖条，网格两侧留白不贴边。
//   · 素影列表 = 列表感。无轮播，条目无卡片底、只用分隔线，更紧凑。
//   · 星河横幅 = 影院感。大图横滑，标题压在图上配渐变蒙层。

import core.widgets;
import peek.home;

widget ToolIcon = GestureDetector(
  onTap: args.onTap,
  child: Container(
    padding: [6.0],
    child: Icon(
      icon: args.icon.icon,
      fontFamily: args.icon.fontFamily,
      size: 20.0,
      color: data.home.theme.textPrimary,
    ),
  ),
);

widget TabButton = GestureDetector(
  onTap: event "selectType" { typeId: args.typeId },
  child: Container(
    padding: [12.0, 7.0],
    margin: [0.0, 0.0, 8.0, 0.0],
    decoration: {
      type: "box",
      color: switch args.selected {
        true: data.home.theme.accentFill,
        false: 0x00000000,
      },
      borderRadius: [data.home.theme.radiusPill],
    },
    child: Text(
      text: args.name,
      style: {
        color: switch args.selected {
          true: data.home.theme.onAccent,
          false: data.home.theme.textPrimary,
        },
        fontSize: 13.0,
        fontWeight: "w600",
      },
    ),
  ),
);

widget FilterChip = GestureDetector(
  onTap: event "selectFilter" {
    key: args.option.filterKey,
    value: args.option.value,
  },
  child: Container(
    padding: [10.0, 5.0],
    margin: [0.0, 0.0, 8.0, 8.0],
    decoration: {
      type: "box",
      color: switch args.option.selected {
        true: data.home.theme.accentFill,
        false: data.home.theme.chipBg,
      },
      borderRadius: [data.home.theme.radiusChip],
      border: [
        {
          color: switch args.option.selected {
            true: data.home.theme.accentFill,
            false: data.home.theme.border,
          },
          width: 1.0,
        },
      ],
    },
    child: Text(
      text: args.option.name,
      style: {
        color: switch args.option.selected {
          true: data.home.theme.onAccent,
          false: data.home.theme.textSecondary,
        },
        fontSize: 12.0,
      },
    ),
  ),
);

widget FilterGroup = Container(
  padding: [12.0, 4.0, 12.0, 4.0],
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Text(
        text: args.group.name,
        style: {
          color: data.home.theme.textSecondary,
          fontSize: 12.0,
          fontWeight: "w600",
        },
      ),
      SizedBox(height: 6.0),
      Wrap(
        spacing: 0.0,
        runSpacing: 0.0,
        children: [
          ...for option in args.group.options: FilterChip(option: option),
        ],
      ),
    ],
  ),
);

// ── 轮播卡：底部渐变蒙层压字（比纯色色块柔和）────────────────────
widget HeroCard = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(
    margin: [0.0, 0.0, 8.0, 0.0],
    decoration: { type: "box", borderRadius: [data.home.theme.radiusCard] },
    child: ClipRRect(
      borderRadius: [data.home.theme.radiusCard],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic, fit: "cover"),
          Positioned(
            start: 0.0,
            end: 0.0,
            bottom: 0.0,
            child: Container(
              padding: [12.0, 26.0, 12.0, 10.0],
              decoration: {
                type: "box",
                gradient: {
                  type: "linear",
                  begin: "bottomCenter",
                  end: "topCenter",
                  colors: [data.home.theme.scrim, 0x00000000],
                },
              },
              child: Column(
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: args.item.name,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: data.home.theme.onImage,
                      fontSize: 15.0,
                      fontWeight: "w700",
                    },
                  ),
                  Text(
                    text: args.item.remarks,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: data.home.theme.onImage,
                      fontSize: 11.5,
                    },
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

// ── 网格海报：1px 细描边靠"外圈底色 + 内缩 1px"实现 ──────────────
// 直接给 Container 加 border 会被里面的图片盖住（BoxDecoration 的
// border 画在背景层），所以用 padding: 1 + 外层填 border 色的办法。
widget PosterItem = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Expanded(
        child: Container(
          padding: [1.0],
          decoration: {
            type: "box",
            color: data.home.theme.border,
            borderRadius: [data.home.theme.radiusCard],
          },
          child: ClipRRect(
            borderRadius: [data.home.theme.radiusCard],
            child: T4Image(url: args.item.pic, fit: "cover"),
          ),
        ),
      ),
      SizedBox(height: 6.0),
      Text(
        text: args.item.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: data.home.theme.textPrimary,
          fontSize: 13.0,
          fontWeight: "w600",
        },
      ),
      Text(
        text: args.item.remarks,
        maxLines: 1,
        overflow: "ellipsis",
        style: { color: data.home.theme.textTertiary, fontSize: 11.5 },
      ),
    ],
  ),
);

// ── 横向条目：卡片底 + 大圆角（网格主题里"卡片"是实体块）────────
widget RowItem = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      color: data.home.theme.card,
      borderRadius: [data.home.theme.radiusCardLg],
    },
    padding: [10.0],
    child: Row(
      children: [
        ClipRRect(
          borderRadius: [8.0],
          child: SizedBox(
            width: 92.0,
            height: 124.0,
            child: T4Image(url: args.item.pic, fit: "cover"),
          ),
        ),
        SizedBox(width: 12.0),
        Expanded(
          child: Column(
            crossAxisAlignment: "start",
            children: [
              Text(
                text: args.item.name,
                maxLines: 2,
                overflow: "ellipsis",
                style: {
                  color: data.home.theme.textPrimary,
                  fontSize: 15.0,
                  fontWeight: "w700",
                },
              ),
              SizedBox(height: 5.0),
              Text(
                text: args.item.remarks,
                maxLines: 1,
                overflow: "ellipsis",
                style: {
                  color: data.home.theme.textSecondary,
                  fontSize: 12.0,
                },
              ),
              Text(
                text: args.item.year,
                style: {
                  color: data.home.theme.textTertiary,
                  fontSize: 11.5,
                },
              ),
            ],
          ),
        ),
      ],
    ),
  ),
);

widget BannerItem = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Container(
    margin: [12.0, 6.0],
    decoration: { type: "box", borderRadius: [data.home.theme.radiusCard] },
    child: ClipRRect(
      borderRadius: [data.home.theme.radiusCard],
      child: Stack(
        children: [
          T4Image(url: args.item.pic, fit: "cover"),
          Positioned(
            start: 0.0,
            end: 0.0,
            bottom: 0.0,
            child: Container(
              padding: [12.0, 26.0, 12.0, 10.0],
              decoration: {
                type: "box",
                gradient: {
                  type: "linear",
                  begin: "bottomCenter",
                  end: "topCenter",
                  colors: [data.home.theme.scrim, 0x00000000],
                },
              },
              child: Column(
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: args.item.name,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: data.home.theme.onImage,
                      fontSize: 15.0,
                      fontWeight: "w700",
                    },
                  ),
                  Text(
                    text: args.item.remarks,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: data.home.theme.onImage,
                      fontSize: 11.5,
                    },
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

widget Header = Container(
  color: data.home.theme.surface,
  padding: [12.0, 12.0, 12.0, 4.0],
  child: Column(
    children: [
      Row(
        children: [
          Expanded(
            child: Text(
              text: data.home.source,
              maxLines: 1,
              overflow: "ellipsis",
              style: {
                color: data.home.theme.textPrimary,
                fontSize: 16.0,
                fontWeight: "w700",
              },
            ),
          ),
          // 换源（2026-10-30）：挪到顶栏功能按钮这一排 ——
          // 原来它挂在分组标题右边当一个文字链接，用户：「换源也要在那个按钮边上」。
          ToolIcon(
            icon: data.home.icons.source,
            onTap: event "showSourcePicker" {},
          ),
          ToolIcon(icon: data.home.icons.search, onTap: event "openSearch" {}),
          ToolIcon(icon: data.home.icons.refresh, onTap: event "refresh" {}),
          ToolIcon(
            icon: data.home.icons.layout,
            onTap: event "showDisplayStylePicker" {},
          ),
          ToolIcon(
            icon: data.home.icons.filter,
            onTap: event "toggleFilters" {},
          ),
        ],
      ),
      SizedBox(height: 8.0),
      SingleChildScrollView(
        scrollDirection: "horizontal",
        child: Row(
          children: [
            ...for entry in data.home.classes: TabButton(
              typeId: entry.typeId,
              name: entry.typeName,
              selected: entry.selected,
            ),
          ],
        ),
      ),
      switch data.home.showFilters {
        true: Column(
          children: [
            ...for group in data.home.filters: FilterGroup(group: group),
          ],
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

// 分组标题：强调色竖条 + 文字（网格主题的"目录"记号）
widget SectionTitle = Container(
  color: data.home.theme.surface,
  padding: [12.0, 8.0],
  child: Row(
    children: [
      Container(
        width: 3.0,
        height: 13.0,
        margin: [0.0, 0.0, 8.0, 0.0],
        decoration: {
          type: "box",
          color: data.home.theme.accent,
          borderRadius: [2.0],
        },
      ),
      Text(
        text: ["全部剧集 · ", data.home.totalLabel, " 部"],
        style: {
          color: data.home.theme.textPrimary,
          fontSize: 14.0,
          fontWeight: "w700",
        },
      ),
    ],
  ),
);

widget root = Container(
  color: data.home.theme.bg,
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend {
      true: data.home.heroHeight,
      false: 0.0,
    },
    pinnedHeight: data.home.stickyHeaderHeight,
    sectionHeight: 40.0,
    crossAxisCount: switch data.home.displayStyle {
      "grid": data.home.gridColumns,
      "largeGrid": data.home.largeGridColumns,
      "banner": data.home.bannerColumns,
      "list": 1,
      "list2": 1,
      "textList": 1,
      "card": 1,
      default: data.home.gridColumns,
    },
    childAspectRatio: switch data.home.displayStyle {
      "grid": 0.72,
      "largeGrid": 0.72,
      "banner": 1.2,
      "list": data.home.wideListRatio,
      "list2": data.home.textListRatio,
      "textList": data.home.textListRatio,
      "card": 2.1,
      default: 0.72,
    },
    mainAxisSpacing: 10.0,
    crossAxisSpacing: 10.0,
    horizontalPadding: 12.0,
    bottomPadding: 28.0,
    hero: PeekCarousel(
      height: data.home.heroHeight,
      viewportFraction: 0.88,
      autoPlay: true,
      autoPlayInterval: 4.0,
      activeColor: data.home.theme.accentFill,
      inactiveColor: data.home.theme.border,
      children: [
        ...for item in data.home.home.recommend: HeroCard(item: item),
      ],
    ),
    pinnedHeader: Header(),
    sectionHeader: SectionTitle(),
    empty: Container(
      alignment: "center",
      padding: [0.0, 48.0],
      child: Text(
        text: switch data.home.loading {
          true: "加载中…",
          false: "暂无内容",
        },
        style: { color: data.home.theme.textTertiary, fontSize: 14.0 },
      ),
    ),
    children: [
      ...for item in data.home.items: switch data.home.displayStyle {
        "list": RowItem(item: item),
        "list2": RowItem(item: item),
        "textList": RowItem(item: item),
        "banner": BannerItem(item: item),
        "card": BannerItem(item: item),
        default: PosterItem(item: item),
      },
    ],
  ),
);
