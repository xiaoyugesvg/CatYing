// --------------------- 卡片选择器 ---------------------
widget ThemeItem = switch data.home.displayStyle {
  "grid": PosterCard(item: args.item),
  "largeGrid": LargePosterCard(item: args.item),
  "banner": BannerCard(item: args.item),
  "list": ListCard(item: args.item),
  "list2": CompactCard(item: args.item),
  "textList": TextOnlyCard(item: args.item),
  "card": WideCollectionCard(item: args.item),
  default: PosterCard(item: args.item),
};

// --------------------- 空状态 ---------------------
// 加载骨架（2026-10-30）：原来只有一行「正在准备春日记忆片单…」，
// 整块内容区空着。现在铺与真实卡片同尺寸的圆角灰块。
// ⚠️ 颜色只能走 decoration: {type:"box", ...}，color 与 decoration 同时
//    非空会让 RFW 的 AnimatedContainer 断言崩。
widget SkeletonPoster = Column(
  crossAxisAlignment: "start",
  children: [
    Container(
      height: 150.0,
      decoration: {
        type: "box",
        color: 0xFFDCEFDC,
        borderRadius: [ { x: 14.0 } ],
      },
    ),
    Padding(
      padding: [ 0.0, 8.0, 0.0, 0.0 ],
      child: Container(
        height: 10.0,
        decoration: {
          type: "box",
          color: 0xFFE8F5E9,
          borderRadius: [ { x: 5.0 } ],
        },
      ),
    ),
    Padding(
      padding: [ 0.0, 6.0, 0.0, 0.0 ],
      child: Container(
        width: 52.0,
        height: 10.0,
        decoration: {
          type: "box",
          color: 0xFFE8F5E9,
          borderRadius: [ { x: 5.0 } ],
        },
      ),
    ),
  ],
);

widget LoadingSkeleton = Container(
  padding: [ 12.0, 14.0, 12.0, 0.0 ],
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Row(
        children: [
          Container(
            width: 96.0,
            height: 13.0,
            decoration: {
              type: "box",
              color: 0xFFDCEFDC,
              borderRadius: [ { x: 7.0 } ],
            },
          ),
          Spacer(),
          Container(
            width: 42.0,
            height: 13.0,
            decoration: {
              type: "box",
              color: 0xFFDCEFDC,
              borderRadius: [ { x: 7.0 } ],
            },
          ),
        ],
      ),
      Padding(
        padding: [ 0.0, 14.0, 0.0, 0.0 ],
        child: Row(
          crossAxisAlignment: "start",
          children: [
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
            Expanded(child: SkeletonPoster()),
          ],
        ),
      ),
      Padding(
        padding: [ 0.0, 12.0, 0.0, 0.0 ],
        child: Row(
          crossAxisAlignment: "start",
          children: [
            Expanded(child: SkeletonPoster()),
            SizedBox(width: 10.0),
