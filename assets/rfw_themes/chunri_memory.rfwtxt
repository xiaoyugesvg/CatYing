);

widget EmptyState = switch data.home.loading {
  true: LoadingSkeleton(),

  false: switch data.home.errorMessage {
    "": Center(
      child: Text(
        text: "暂无可展示内容",
        style: { color: 0xFF8BA98B, fontSize: 13.0 },
      ),
    ),
    default: GestureDetector(
      onTap: event "refresh" {},
      child: Center(
        child: Text(
          text: data.home.errorMessage,
          maxLines: 2,
          overflow: "ellipsis",
          style: { color: 0xFF43A047, fontSize: 12.0 },
        ),
      ),
    ),
  },
};

// --------------------- 根布局（添加整体外框）---------------------
widget root = Container(
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: -1.0, y: -1.0 },
      end: { x: 1.0, y: 1.0 },
      colors: [
        0xFFF5F9F5,
        0xFFFFFFFF,
        0xFFE8F5E9,
      ],
      stops: [0.0, 0.5, 1.0],
    },
  },
  child: Container(
    margin: [1.0, 0.0, 1.0, 0.0],
    decoration: {
      type: "box",
      borderRadius: [ { x: 20.0 } ],
      border: [ { color: 0xFFC8E6C9, width: 1.0 } ],
      color: 0x00000000,
    },
    child: AnimationDefaults(
      duration: 360,
      curve: "easeOutCubic",
      child: PeekStickyGrid(
        heroHeight: switch data.home.hasRecommend {
          true: switch data.home.gridColumns {
            3: 270.0,
            4: 280.0,
            5: 290.0,
            6: 300.0,
            default: 230.0,
          },
          false: 0.0,
        },
        pinnedHeight: data.home.stickyHeaderHeight,
        sectionHeight: 64.0,
        crossAxisCount: switch data.home.displayStyle {
          "grid": data.home.gridColumns,
          "largeGrid": data.home.largeGridColumns,
          "banner": 1,
          "list": 1,
          "list2": 1,
          "textList": 1,
          "card": 1,
          default: data.home.gridColumns,
        },
        childAspectRatio: switch data.home.displayStyle {
          "grid": 0.67,
          "largeGrid": 0.56,
          "banner": data.home.wideListRatio,
          "list": data.home.wideListRatio,
          "list2": data.home.textListRatio,
          "textList": data.home.textListRatio,
          "card": data.home.wideListRatio,
          default: 0.55,
        },
        mainAxisSpacing: 13.0,
        crossAxisSpacing: 11.0,
        horizontalPadding: 14.0,
        bottomPadding: 96.0,
        hero: switch data.home.hasRecommend {
          true: PeekCarousel(
            autoPlay: true,
            style: "stack",
            showIndicators: false,
            interval: 4300,
            viewportFraction: 1.0,
            stackScale: 0.74,
            stackOpacity: 1.0,
            stackOffset: 0.24,
            stackRotation: 0.0,
            activeColor: 0xFF43A047,
            inactiveColor: 0x33C8E6C9,
            children: [
              ...for item in data.home.home.recommend:
                HeroPoster(item: item),
            ],
          ),
          false: SizedBoxShrink(),
        },
        pinnedHeader: CategoryHeader(),
        sectionHeader: RecommendToolbar(),
        empty: EmptyState(),
        children: [
          ...for item in data.home.items:
            ThemeItem(item: item),
        ],
      ),
    ),
  ),
);