);

// 顶部栏主体
widget RecommendToolbar = Container(
  padding: [14.0, 8.0],
  decoration: {
    type: "box",
    color: 0xFFF5F9F5,
    border: [ { color: 0x33C8E6C9, width: 1.0 } ],
  },
  child: Row(
    children: [
      Container(
        width: 4.0,
        height: 26.0,
        decoration: {
          type: "box",
          gradient: {
            type: "linear",
            begin: { x: 0.0, y: -1.0 },
            end: { x: 0.0, y: 1.0 },
            colors: [0xFF43A047, 0xFF2E7D32],
          },
          borderRadius: [ { x: 2.0 } ],
        },
      ),
      Flexible(
        fit: "tight",
