    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.layout, action: event "showDisplayStylePicker" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.source, action: event "showSourcePicker" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.api, action: event "showApiConfigPicker" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.search, action: event "openSearch" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.push, action: event "openPush" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.history, action: event "openHistory" {})),
    Padding(padding: [0.0, 0.0, 3.0, 0.0], child: TinyToolButton(icon: data.home.icons.favorite, action: event "openFavorite" {})),
