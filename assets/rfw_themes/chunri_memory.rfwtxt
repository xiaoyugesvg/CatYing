            child: T4Image(url: args.item.pic),
          ),
        ),
        Container(
          width: 46.0,
          alignment: { x: 0.0, y: 0.0 },
          child: Text(
            text: args.item.rankLabel,
            style: { color: 0xFF43A047, fontSize: 14.0, fontWeight: "w900" },
          ),
        ),
        Expanded(
          child: SingleChildScrollView(
            scrollDirection: "horizontal",
            child: Text(
              text: args.item.name,
              maxLines: 1,
              style: { color: 0xFF0D1B0D, fontSize: 12.0, fontWeight: "w800" },
            ),
          ),
        ),
        switch args.item.remarks {
          "": SizedBoxShrink(),
          default: Padding(
            padding: [8.0, 0.0],
            child: Text(
              text: args.item.remarks,
              maxLines: 1,
              overflow: "ellipsis",
              style: { color: 0xFF8BA98B, fontSize: 11.0 },
            ),
          ),
        },
        Icon(
          icon: data.home.icons.open.icon,
          fontFamily: data.home.icons.open.fontFamily,
          size: 17.0,
          color: 0xFF43A047,
        ),
      ],
    ),
  ),
);

