// 春日记忆 · 绿色清新主题
import core.widgets;
import peek.home;

// --------------------- Hero 推荐卡片（带元数据）---------------------
widget HeroPoster = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Center(
    child: AspectRatio(
      aspectRatio: switch data.home.gridColumns {
        3: 0.70,
        4: 0.62,
        5: 0.68,
        6: 0.70,
        default: 0.56,
      },
      child: Container(
        margin: [8.0, 10.0],
        decoration: {
          type: "box",
          color: 0xFFFFFFFF,
          borderRadius: [ { x: 24.0 } ],
          border: [ { color: 0x99C8E6C9, width: 1.0 } ],
          boxShadow: [
            { color: 0x332E7D32, blurRadius: 28.0, offset: { x: 0.0, y: 16.0 }, spreadRadius: 1.0 },
            { color: 0x1A2E7D32, blurRadius: 18.0, offset: { x: 0.0, y: 5.0 } },
          ],
        },
        child: ClipRRect(
          borderRadius: [ { x: 24.0 } ],
          child: Stack(
            fit: "expand",
            children: [
              T4Image(url: args.item.pic),
              Container(
                decoration: {
                  type: "box",
                  gradient: {
                    type: "linear",
                    begin: { x: 0.0, y: -1.0 },
                    end: { x: 0.0, y: 1.0 },
                    colors: [0x00000000, 0x05000000, 0xC97EC8E3],
                  },
                },
              ),
              Align(
                alignment: { x: -1.0, y: 1.0 },
                child: Padding(
                  padding: [12.0, 12.0, 12.0, 13.0],
                  child: Column(
                    mainAxisSize: "min",
                    crossAxisAlignment: "start",
                    children: [
                      switch args.item.year {
                        "": switch args.item.typeName {
                          "": SizedBoxShrink(),
                          default: Padding(
                            padding: [0.0, 0.0, 0.0, 4.0],
                            child: Text(
                              text: args.item.typeName,
                              maxLines: 1,
                              overflow: "ellipsis",
                              style: { color: 0xFF66BB6A, fontSize: 12.0, fontWeight: "w600" },
                            ),
                          ),
                        },
                        default: Padding(
                          padding: [0.0, 0.0, 0.0, 4.0],
                          child: Text(
                            text: switch args.item.typeName {
                              "": args.item.year,
                              default: [args.item.year, " / ", args.item.typeName],
                            },
                            maxLines: 1,
                            overflow: "ellipsis",
                            style: { color: 0xFF66BB6A, fontSize: 12.0, fontWeight: "w600" },
                          ),
                        ),
                      },
                      Text(
                        text: args.item.name,
                        maxLines: 2,
                        overflow: "ellipsis",
                        style: { color: 0xFFFFFFFF, fontSize: 14.0, fontWeight: "w900", height: 1.05 },
                      ),
                      switch args.item.remarks {
                        "": SizedBoxShrink(),
                        default: Padding(
                          padding: [0.0, 5.0, 0.0, 0.0],
                          child: Text(
                            text: args.item.remarks,
                            maxLines: 1,
                            overflow: "ellipsis",
                            style: { color: 0xFF66BB6A, fontSize: 12.0, fontWeight: "w600" },
                          ),
                        ),
                      },
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    ),
  ),
);

// --------------------- 分类 ---------------------
widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    height: 42.0,
    margin: [0.0, 6.0, 2.0, 6.0],
    padding: [16.0, 0.0],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: switch args.item.selected {
        true: {
          type: "linear",
          begin: { x: -1.0, y: -1.0 },
          end: { x: 1.0, y: 1.0 },
          colors: [0xFF43A047, 0xFF2E7D32],
        },
        false: {
          type: "linear",
          colors: [0xFFFFFFFF, 0xFFF5F9F5],
        },
      },
      borderRadius: [ { x: 18.0 } ],
      border: [
        {
          color: switch args.item.selected { true: 0xFF43A047, false: 0xFFC8E6C9 },
          width: 1.0,
        },
      ],
      boxShadow: switch args.item.selected {
        true: [ { color: 0x332E7D32, blurRadius: 14.0, offset: { x: 0.0, y: 5.0 } } ],
        false: [ { color: 0x0D2E7D32, blurRadius: 8.0, offset: { x: 0.0, y: 3.0 } } ],
      },
    },
    child: Text(
      text: args.item.typeName,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFF0D1B0D },
        fontSize: 14.0,
        fontWeight: "w900",
        height: 1.0,
      },
    ),
  ),
);

// --------------------- 工具按钮 ---------------------
widget ToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 36.0,
    height: 36.0,
    margin: [1.0, 0.0, 0.0, 0.0],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: {
        type: "linear",
        begin: { x: -1.0, y: -1.0 },
        end: { x: 1.0, y: 1.0 },
        colors: [0xFFFFFFFF, 0xFFF5F9F5],
      },
      borderRadius: [ { x: 18.0 } ],
      border: [ { color: 0xFFC8E6C9, width: 1.0 } ],
      boxShadow: [ { color: 0x332E7D32, blurRadius: 10.0, offset: { x: 0.0, y: 5.0 } } ],
    },
    child: Icon(
      icon: args.icon.icon,
      fontFamily: args.icon.fontFamily,
      size: 18.0,
      color: 0xFF43A047,
    ),
  ),
);

// 小型工具按钮
widget TinyToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 37.0,
    height: 37.0,
    margin: [0.0, 4.0, 0.0, 4.0],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: {
        type: "linear",
        colors: [0xFFFFFFFF, 0xFFF5F9F5],
      },
      borderRadius: [ { x: 14.0 } ],
      border: [ { color: 0xFFC8E6C9, width: 1.0 } ],
      boxShadow: [ { color: 0x142E7D32, blurRadius: 6.0, offset: { x: 0.0, y: 3.0 } } ],
    },
    child: Icon(
      icon: args.icon.icon,
      fontFamily: args.icon.fontFamily,
      size: 18.0,
      color: 0xFF43A047,
    ),
  ),
);

// --------------------- 过滤器选项与行（支持展开）---------------------
widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    height: 30.0,
    margin: [0.0, 4.0, 2.0, 4.0],
    padding: [11.0, 0.0],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected { true: 0xFF43A047, false: 0xFFFFFFFF },
      borderRadius: [ { x: 13.0 } ],
      border: [
        {
          color: switch args.item.selected { true: 0xFF43A047, false: 0xFFC8E6C9 },
          width: 1.0,
        },
      ],
    },
    child: Text(
      text: args.item.name,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFF0D1B0D },
        fontSize: 12.0,
        fontWeight: "w800",
        height: 1.0,
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Container(
      width: 62.0,
      child: Text(
        text: args.group.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: { color: 0xFF43A047, fontSize: 12.0, fontWeight: "w900" },
      ),
    ),
    Expanded(
      child: SingleChildScrollView(
        scrollDirection: "horizontal",
        child: Row(
          mainAxisSize: "min",
          children: [
          ...for option in args.group.options:
            FilterOption(item: option),
        ],
        ),
      ),
    ),
    switch args.group.canExpand {
      true: ToolButton(
        icon: data.home.icons.expand,
        action: event "showFilterPicker" { key: args.group.key },
      ),
      false: SizedBoxShrink(),
    },
  ],
);

// --------------------- 分类头（分类滚动条 + 筛选面板）---------------------
widget CategoryHeader = Column(
  children: [
    Container(
      decoration: {
        type: "box",
        color: 0xFAF5F9F5,
        boxShadow: [ { color: 0x142E7D32, blurRadius: 16.0, offset: { x: 0.0, y: 8.0 } } ],
      },
      child: Container(
        height: 54.0,
        padding: [14.0, 0.0],
        child: SingleChildScrollView(
          scrollDirection: "horizontal",
          child: Row(
            mainAxisSize: "min",
            children: [
            ...for item in data.home.classes:
              CategoryChip(item: item),
          ],
          ),
        ),
      ),
    ),
    switch data.home.showFilters {
      true: Container(
        margin: [14.0, 4.0, 14.0, 6.0],
        child: PeekGlass(
          blur: 20.0,
          radius: 16.0,
          tintColor: 0x08FFFFFF,
          borderColor: 0xFFC8E6C9,
          borderWidth: 1.0,
          child: Container(
            height: data.home.filterPanelHeight,
            padding: [10.0, 4.0],
            child: SingleChildScrollView(
              child: Column(
                children: [
                ...for group in data.home.filters:
                  Container(height: 39.0, child: FilterRow(group: group)),
              ],
              ),
            ),
          ),
        ),
      ),
      false: SizedBoxShrink(),
    },
  ],
);

// --------------------- 顶部栏（站源名 + 所有工具按钮）---------------------
widget SectionTitleSource = GestureDetector(
  onTap: event "showSourcePicker" {},
  child: Column(
    mainAxisSize: "min",
    crossAxisAlignment: "start",
    children: [
      Text(
        text: switch data.home.source.name {
          "": "春日记忆片库",
          default: data.home.source.name,
        },
        maxLines: 1,
        overflow: "ellipsis",
        style: { color: 0xFF0D1B0D, fontSize: 16.0, fontWeight: "w900" },
      ),
      Padding(
        padding: [0.0, 1.0, 0.0, 0.0],
        child: Text(
          text: "🌿切换站源",
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: 0xFF8BA98B, fontSize: 12.0, fontWeight: "w600" },
        ),
      ),
    ],
  ),
);

// ★ 紧凑工具栏（竖屏）
widget SectionActionsCompact = SingleChildScrollView(
  scrollDirection: "horizontal",
  child: Row(
    mainAxisSize: "min",
    children: [
    switch data.home.hasManyClasses {
      true: Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.expand, action: event "showCategoryPicker" {})),
      false: SizedBoxShrink(),
    },
    switch data.home.hasFilters {
      true: Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.filter, action: event "toggleFilters" {})),
      false: SizedBoxShrink(),
    },
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.layout, action: event "showDisplayStylePicker" {})),
    // 2026-10-30：换源按钮原来只在宽屏工具栏里有，竖屏就点不到换源了
    //（用户：「换源也要在那个按钮边上」）。补进紧凑工具栏。
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.source, action: event "showSourcePicker" {})),
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.api, action: event "showApiConfigPicker" {})),
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.search, action: event "openSearch" {})),
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.push, action: event "openPush" {})),
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.history, action: event "openHistory" {})),
    Padding(padding: [0.0, 0.0, 1.0, 0.0], child: TinyToolButton(icon: data.home.icons.favorite, action: event "openFavorite" {})),
    TinyToolButton(icon: data.home.icons.refresh, action: event "refresh" {}),
  ],
  ),
);

// ★ 宽屏工具栏（横屏/平板）
widget SectionActionsWide = SingleChildScrollView(
