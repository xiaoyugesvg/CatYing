{
  "runtime": "python",
  "version": "3.12 (b11)",
  "build": "3.12-b11",
  "package": "Python-3.12-iOS-support.b11.tar.gz",
  "source": "https://github.com/beeware/Python-Apple-support/releases/download/3.12-b11/Python-3.12-iOS-support.b11.tar.gz",
  "stdlib": "Python.xcframework/ios-arm64/lib-arm64/python3.12",
  "libs": [
    "requests",
    "httpx",
    "beautifulsoup4",
    "flask",
    "lxml(纯 Python 垫片)",
    "pycryptodome(纯 Python 垫片 Crypto)",
    "pyquery(纯 Python 垫片)"
  ],
  "note": "requests/httpx/beautifulsoup4/flask 由 CI pip --target 安装（纯 Python，跨平台）；lxml/pycryptodome/pyquery 的真库依赖 C 扩展、iOS 无法交叉编译，由 assets/python-project/pylib/ 提供同名 API 的纯 Python 实现；精确 patch 版本以运行时 sys.version 为准。"
}
